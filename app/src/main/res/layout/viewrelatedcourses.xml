<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".viewRelatedCourses">

    <ImageView
        android:id="@+id/topimg"
        android:layout_width="426dp"
        android:layout_height="281dp"
        android:layout_marginBottom="343dp"
        android:alpha="0.4"
        android:src="@drawable/office_slave"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/middleimg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/middleimg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:alpha="0.3"
        android:layerType="none"
        android:src="@drawable/me_making_chocolate"
        app:layout_constraintBottom_toBottomOf="@+id/mainUI"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/textView4"
        app:layout_constraintVertical_bias="0.624" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="306dp"
        android:layout_height="191dp"
        android:fontFamily="sans-serif-condensed-medium"
        android:text="view possible related courses"
        android:textColor="#000000"
        android:textSize="48sp"
        app:layout_constraintBottom_toBottomOf="@+id/mainUI"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageView
        android:id="@+id/bottomimg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="424dp"
        android:alpha="0.3"
        android:src="@drawable/asiandudestudyingloremipsum"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/topimg" />

    <ImageView
        android:id="@+id/mainUI"
        android:layout_width="306dp"
        android:layout_height="618dp"
        android:layout_marginBottom="4dp"
        android:alpha="0.8"
        android:src="@drawable/naligo_ka_na_ba"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/bottomimg"
        app:layout_constraintHorizontal_bias="0.495"
        app:layout_constraintStart_toStartOf="@+id/bottomimg"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/apbutton"
        android:layout_width="79dp"
        android:layout_height="79dp"
        android:layout_marginTop="32dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.762"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/middleimg" />

    <Button
        android:id="@+id/linguisticsbutton"
        android:layout_width="79dp"
        android:layout_height="79dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/apbutton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.759"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mapehbutton"
        app:layout_constraintVertical_bias="0.971" />

    <Button
        android:id="@+id/mathbutton"
        android:layout_width="79dp"
        android:layout_height="79dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/linguisticsbutton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.762"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mapehbutton"
        app:layout_constraintVertical_bias="0.94" />

    <Button
        android:id="@+id/mapehbutton"
        android:layout_width="79dp"
        android:layout_height="79dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/apbutton"
        app:layout_constraintEnd_toEndOf="@+id/middleimg"
        app:layout_constraintHorizontal_bias="0.762"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tlebutton"
        app:layout_constraintVertical_bias="0.271" />

    <Button
        android:id="@+id/ictbutton"
        android:layout_width="79dp"
        android:layout_height="79dp"
        android:layout_marginBottom="20dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintBottom_toTopOf="@+id/mapehbutton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.762"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mainUI"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/tlebutton"
        android:layout_width="63dp"
        android:layout_height="70dp"
        android:text="Button"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/mainUI"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.75"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/mainUI"
        app:layout_constraintVertical_bias="0.218" />

</androidx.constraintlayout.widget.ConstraintLayout>