<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Survey">

    <ImageView
        android:id="@+id/imageView2"
        android:layout_width="436dp"
        android:layout_height="930dp"
        android:layout_marginStart="3dp"
        android:scaleX="3"
        android:scaleY="4.2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/background1_survey"
        tools:ignore="MissingConstraints" />


    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar2"
        android:layout_width="405dp"
        android:layout_height="541dp"
        android:layout_marginStart="12dp"
        android:layout_marginTop="139dp"
        android:layout_marginEnd="5dp"
        android:layout_marginBottom="64dp"
        android:background="#035F2E"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.565"
        tools:ignore="MissingConstraints"
        tools:visibility="visible" />

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/materialToolbar"
        android:layout_width="363dp"
        android:layout_height="462dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="257dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="172dp"
        android:background="#07BE5E"
        android:minHeight="?attr/actionBarSize"
        android:theme="?attr/actionBarTheme"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints"
        tools:visibility="visible" />

    <Button
        android:id="@+id/answerYesButton"
        android:layout_width="121dp"
        android:layout_height="78dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="563dp"
        android:layout_marginEnd="258dp"
        android:layout_marginBottom="250dp"
        android:backgroundTint="#344B40"
        android:text="Yes"
        android:textAppearance="@style/TextAppearance.AppCompat.Display2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/answerNoButton"
        android:layout_width="121dp"
        android:layout_height="78dp"
        android:layout_marginStart="251dp"
        android:layout_marginTop="563dp"
        android:layout_marginEnd="39dp"
        android:layout_marginBottom="250dp"
        android:backgroundTint="#344B40"
        android:text="No"
        android:textAppearance="@style/TextAppearance.AppCompat.Display2"
        android:textColorLink="#344B40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="MissingConstraints" />

    <Button
        android:id="@+id/exitSurveyButton"
        android:layout_width="144dp"
        android:layout_height="82dp"
        android:layout_marginStart="269dp"
        android:layout_marginTop="691dp"
        android:backgroundTint="#12D57D"
        android:text="Exit"
        android:textAppearance="@style/TextAppearance.AppCompat.Display2"
        android:textColorLink="#344B40"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="353dp"
        android:layout_height="124dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="276dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="212dp"
        android:text="Do you enjoy the process of thinking of solutions?"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.AppCompat.Display1"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.344"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.382"
        tools:ignore="MissingConstraints" />

    <TextView
        android:id="@+id/textView3"
        android:layout_width="353dp"
        android:layout_height="88dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="172dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="381dp"
        android:text="QUESTION #1"
        android:textAllCaps="false"
        android:textAppearance="@style/TextAppearance.AppCompat.Display3"
        android:textColor="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.452"
        tools:ignore="MissingConstraints" />


</androidx.constraintlayout.widget.ConstraintLayout>