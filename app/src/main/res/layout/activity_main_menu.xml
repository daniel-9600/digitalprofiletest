<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:context=".MainMenu"
    tools:visibility="visible">

    <Button
        android:id="@+id/possibleCoursesButton"
        android:layout_width="75dp"
        android:layout_height="119dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="765dp"
        android:layout_marginEnd="327dp"
        android:layout_marginBottom="16dp"
        android:text="POSSIBLE COURSES"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:visibility="visible" />


    <ImageView
        android:id="@+id/MainMenu_backgroundimage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleY="1.6"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.454"
        app:srcCompat="@drawable/background_mainmenu" />

    <ImageView
        android:id="@+id/MainMenu_foregroundUI"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="450dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/uielement1_mainmenu" />

    <Button
        android:id="@+id/AboutUsButton"
        android:layout_width="66dp"
        android:layout_height="87dp"
        android:layout_marginStart="333dp"
        android:layout_marginTop="774dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="30dp"
        android:text="ABOUT US"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:visibility="invisible" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="99dp"
        android:layout_height="41dp"
        android:layout_marginStart="216dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="76dp"
        android:layout_marginBottom="775dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:scaleX="1"
        android:scaleY="1"
        android:text=".@gmail"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="Autofill,HardcodedText,LabelFor,MissingConstraints" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="216dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="126dp"
        android:layout_marginBottom="800dp"
        android:text="WELCOME,"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="86dp"
        android:layout_height="19dp"
        android:layout_marginStart="277dp"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="48dp"
        android:layout_marginBottom="800dp"
        android:scaleX="0.55"
        android:scaleY="0.75"
        android:text="EXAMPLEUSER!"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText,TextSizeCheck" />

    <ImageView
        android:id="@+id/MainMenu_SurveyNavigatorUI"
        android:layout_width="250dp"
        android:layout_height="218dp"
        android:layout_marginStart="149dp"
        android:layout_marginTop="199dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="474dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/areyoureadyhighres_removebg_preview" />

    <Button
        android:id="@+id/startSurveyButtonYes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="177dp"
        android:layout_marginTop="300dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="325dp"
        android:text="YES"
        android:textColorLink="@color/background_gradient_start"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/MainMenu_backgroundimage"
        app:layout_constraintEnd_toEndOf="@id/MainMenu_backgroundimage"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/MainMenu_backgroundimage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.387"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:visibility="visible" />

    <Button
        android:id="@+id/startSurveyButtonNo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="275dp"
        android:layout_marginTop="300dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="100dp"
        android:text="NO"
        android:textColorLink="#B3B3B3"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/MainMenu_backgroundimage"
        app:layout_constraintEnd_toEndOf="@id/MainMenu_backgroundimage"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="@id/MainMenu_backgroundimage"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.045"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>