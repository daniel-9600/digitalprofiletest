<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="visible"
    tools:context=".MainMenu"
    tools:visibility="visible">

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="TODO"
        android:importantForAccessibility="no"
        android:scaleX="1"
        android:scaleY="1.260"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/background_mainmenu"
        tools:ignore="ContentDescription,HardcodedText,MissingConstraints"
        tools:layout_editor_absoluteX="0dp" />

    <ImageView
        android:id="@+id/imageView10"
        android:layout_width="259dp"
        android:layout_height="213dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="TODO"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/uielement2_mainmenu"
        tools:ignore="ContentDescription,HardcodedText,MissingConstraints"
        tools:layout_editor_absoluteY="93dp" />

    <ImageView
        android:id="@+id/imageView11"
        android:layout_width="410dp"
        android:layout_height="732dp"
        android:scaleX="1"
        android:scaleY="1.15"
        android:translationX="0px"
        android:translationY="-373px"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        app:srcCompat="@drawable/uielement1_mainmenu"
        tools:ignore="ContentDescription,MissingConstraints" />

    <Button
        android:id="@+id/button11"
        android:layout_width="68dp"
        android:layout_height="80dp"
        android:layout_marginTop="631dp"
        android:layout_marginBottom="20dp"
        android:text="POSSIBLE COURSES"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/imageView6"
        app:layout_constraintTop_toTopOf="@+id/imageView6"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:layout_editor_absoluteX="8dp"
        tools:visibility="invisible" />

    <Button
        android:id="@+id/button12"
        android:layout_width="66dp"
        android:layout_height="87dp"
        android:layout_marginBottom="16dp"
        android:text="ABOUT US"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@+id/imageView6"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:layout_editor_absoluteX="333dp"
        tools:visibility="invisible" />

    <Button
        android:id="@+id/button13"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="135dp"
        android:text="NO"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@+id/imageView10"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:layout_editor_absoluteX="277dp"
        tools:visibility="invisible" />

    <Button
        android:id="@+id/button14"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="135dp"
        android:text="YES"
        android:visibility="invisible"
        app:layout_constraintTop_toTopOf="@+id/imageView10"
        tools:ignore="HardcodedText,MissingConstraints"
        tools:layout_editor_absoluteX="180dp"
        tools:visibility="invisible" />

    <EditText
        android:id="@+id/editTextTextEmailAddress"
        android:layout_width="99dp"
        android:layout_height="41dp"
        android:layout_marginEnd="78dp"
        android:ems="10"
        android:inputType="textEmailAddress"
        android:scaleX="1"
        android:scaleY="1"
        android:text=".@gmail"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="Autofill,HardcodedText,LabelFor,MissingConstraints"
        tools:layout_editor_absoluteY="16dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WELCOME,"
        app:layout_constraintBottom_toTopOf="@+id/editTextTextEmailAddress"
        app:layout_constraintEnd_toStartOf="@+id/textView4"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="HardcodedText" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="86dp"
        android:layout_height="21dp"
        android:layout_marginStart="45dp"
        android:scaleX="0.55"
        android:scaleY="0.75"
        android:text="EXAMPLEUSER!"
        app:layout_constraintBottom_toTopOf="@+id/editTextTextEmailAddress"
        app:layout_constraintStart_toStartOf="@+id/editTextTextEmailAddress"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.8"
        tools:ignore="HardcodedText,TextSizeCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>